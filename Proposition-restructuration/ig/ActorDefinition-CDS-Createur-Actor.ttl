<https://interop.esante.gouv.fr/ig/fhir/cds/Basic/CDS-Createur-Actor> a fhir:Basic ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "CDS-Createur-Actor"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><div xml:lang=\"fr\" lang=\"fr\"><hr/><p><b>French</b></p><hr/><p class=\"res-header-id\"><b>Narratif généré : ActorDefinition CDS-Createur-Actor</b></p><a name=\"CDS-Createur-Actor\"> </a><a name=\"hcCDS-Createur-Actor\"> </a><table class=\"grid\"><tr><td><b>Acteur : CDS_Createur </b></td><td>CDS Créateur</td><td>Type : system </td></tr><tr><td colspan=\"3\"><div><p>Un créateur :</p>\n<ul>\n<li><strong>DOIT</strong> être habilité ;</li>\n</ul>\n<p>Pour une création il :</p>\n<ul>\n<li><strong>DOIT</strong> vérifier l’absence du cercle de soins de la personne par le gestionnaire du cercle de soins via une demande de consultation ;</li>\n<li><strong>DOIT</strong> disposer des paramètres de création de cercle de soins (et en particulier de l’identifiant du patient);\n\n</li>\n</ul>\n<p>Pour une mise à jour il :</p>\n<ul>\n<li><strong>DOIT</strong> disposer des paramètres de mise à jour de cercle de soins (et en particulier de l’identifiant du patient);</li>\n<li>Dans le cas où il y a plusieurs contributeurs : <strong>DOIT</strong> avoir consulté préalablement la dernière version du cercle de soins de la personne dans le gestionnaire du cercle de soins afin de garantir l’intégrité des informations contenues dans le cercle de soins</li>\n</ul>\n<p>Consulter <a href=\"CapabilityStatement-CDSCreateurRestful.html\">CapabilityStatement CDSCreateurRestful</a> et <a href=\"CapabilityStatement-CDSCreateurTransaction.html\">CapabilityStatement CDSCreateurTransaction</a> pour les ressources CapabilityStatement associées à l'acteur.</p>\n</div></td></tr></table></div><div xml:lang=\"en\" lang=\"en\"><hr/><p><b>English</b></p><hr/><p class=\"res-header-id\"><b>Generated Narrative: ActorDefinition CDS-Createur-Actor</b></p><a name=\"en-CDS-Createur-Actor\"> </a><a name=\"en-hcCDS-Createur-Actor\"> </a><table class=\"grid\"><tr><td><b>Actor: CDS_Createur </b></td><td>CDS Créateur</td><td>Type: system </td></tr><tr><td colspan=\"3\"><div><p>Un créateur :</p>\n<ul>\n<li><strong>DOIT</strong> être habilité ;</li>\n</ul>\n<p>Pour une création il :</p>\n<ul>\n<li><strong>DOIT</strong> vérifier l’absence du cercle de soins de la personne par le gestionnaire du cercle de soins via une demande de consultation ;</li>\n<li><strong>DOIT</strong> disposer des paramètres de création de cercle de soins (et en particulier de l’identifiant du patient);\n\n</li>\n</ul>\n<p>Pour une mise à jour il :</p>\n<ul>\n<li><strong>DOIT</strong> disposer des paramètres de mise à jour de cercle de soins (et en particulier de l’identifiant du patient);</li>\n<li>Dans le cas où il y a plusieurs contributeurs : <strong>DOIT</strong> avoir consulté préalablement la dernière version du cercle de soins de la personne dans le gestionnaire du cercle de soins afin de garantir l’intégrité des informations contenues dans le cercle de soins</li>\n</ul>\n<p>Consulter <a href=\"CapabilityStatement-CDSCreateurRestful.html\">CapabilityStatement CDSCreateurRestful</a> et <a href=\"CapabilityStatement-CDSCreateurTransaction.html\">CapabilityStatement CDSCreateurTransaction</a> pour les ressources CapabilityStatement associées à l'acteur.</p>\n</div></td></tr></table></div></div>"
  ] ;
