       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDS Cercle Soins" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Le cercle de soins est l'agrégation de membres qui participent à la prise en charge et aux actions de coordination du parcours de santé d’une personne." ] ;
