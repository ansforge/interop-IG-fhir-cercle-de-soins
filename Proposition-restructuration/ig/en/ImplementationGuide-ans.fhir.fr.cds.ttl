       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDS CareTeam Profile" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil héritant du profil défini dans DCTM et défini pour le volet Gestion du Cercle de Soins. Le concept métier « cercle de soins » correspond à la ressource FHIR « CareTeam »." ] ;
