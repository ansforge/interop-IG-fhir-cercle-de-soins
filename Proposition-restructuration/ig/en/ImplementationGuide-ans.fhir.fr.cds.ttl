         fhir:Reference.reference [ fhir:value "StructureDefinition/cds-exercice-professionnel" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDS Exercice Professionnel" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Informations décrivant notamment la profession exercée, l’identité d’exercice d’un professionnel et le cadre de son exercice (civil, agent public, etc.).Il peut exister plusieurs exercices professionnels pour une personne à un instant donné." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
