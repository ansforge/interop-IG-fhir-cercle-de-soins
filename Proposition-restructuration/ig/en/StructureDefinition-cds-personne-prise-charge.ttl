       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "cds-personne-prise-charge.INS.sexe" ] ;
       fhir:ElementDefinition.path [ fhir:value "cds-personne-prise-charge.INS.sexe" ] ;
       fhir:ElementDefinition.short [ fhir:value "Le sexe est un élément d’identité mentionné à l’article R. 1111-8-6 du CSP. L’identité INS ne peut comporter que des valeurs F (féminin) ou M (masculin)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Le sexe est un élément d’identité mentionné à l’article R. 1111-8-6 du CSP. L’identité INS ne peut comporter que des valeurs F (féminin) ou M (masculin)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
