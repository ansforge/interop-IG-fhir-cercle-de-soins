# - resource -------------------------------------------------------------------

<https://interop.esante.gouv.fr/ig/fhir/cds/StructureDefinition/cds-situation-exercice> a fhir:StructureDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "cds-situation-exercice"] ;
