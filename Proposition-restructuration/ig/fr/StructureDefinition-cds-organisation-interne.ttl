       fhir:index -1 ;
       fhir:Element.id [ fhir:value "cds-organisation-interne.typeFermeture" ] ;
       fhir:ElementDefinition.path [ fhir:value "cds-organisation-interne.typeFermeture" ] ;
       fhir:ElementDefinition.short [ fhir:value "Le type de fermeture d'un niveau organisationnel indique la temporalité de la fermeture. Le type de fermeture s'applique au niveau organisationnel sur lequel la fermeture est déclarée, ainsi que tous les niveaux inférieurs rattachés à ce niveau organisationnel. Par exemple, si un service est fermé temporairement, toutes les unités fonctionnelles qui lui sont rattachées sont également fermées temporairement." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Le type de fermeture d'un niveau organisationnel indique la temporalité de la fermeture. Le type de fermeture s'applique au niveau organisationnel sur lequel la fermeture est déclarée, ainsi que tous les niveaux inférieurs rattachés à ce niveau organisationnel. Par exemple, si un service est fermé temporairement, toutes les unités fonctionnelles qui lui sont rattachées sont également fermées temporairement." ] ;
