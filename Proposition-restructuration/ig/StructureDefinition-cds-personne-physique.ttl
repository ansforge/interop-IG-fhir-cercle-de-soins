       fhir:ElementDefinition.path [ fhir:value "cds-personne-physique.sexeAdministratif" ] ;
       fhir:ElementDefinition.short [ fhir:value "Sexe administratif de la personne physique, au sens de l'état civil, masculin ou féminin." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sexe administratif de la personne physique, au sens de l'état civil, masculin ou féminin." ] ;
