     ], [
       fhir:index 26 ;
       fhir:Element.id [ fhir:value "cds-personne-physique.poidsCorporel" ] ;
       fhir:ElementDefinition.path [ fhir:value "cds-personne-physique.poidsCorporel" ] ;
       fhir:ElementDefinition.short [ fhir:value "Masse du corps de la personne exprimée dans une unité de mesure (kg, g, etc.)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Masse du corps de la personne exprimée dans une unité de mesure (kg, g, etc.)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "PersonnePhysique.poidsCorporel" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
