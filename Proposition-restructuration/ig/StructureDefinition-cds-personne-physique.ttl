       fhir:ElementDefinition.path [ fhir:value "cds-personne-physique.tailleCorporelle" ] ;
       fhir:ElementDefinition.short [ fhir:value "Taille du corps de la personne exprimée dans une unité de mesure (m, cm, etc.).Synonymes: grandeur corporelle, grandeur du corps, hauteur corporelle, hauteur du corps, longueur corporelle." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Taille du corps de la personne exprimée dans une unité de mesure (m, cm, etc.).Synonymes: grandeur corporelle, grandeur du corps, hauteur corporelle, hauteur du corps, longueur corporelle." ] ;
